# Database
DATABASE_URL="file:./dev.db"

# Authentication (required in production, optional in development)
# APP_PASSWORD: The password to access the dashboard
# AUTH_SECRET: A random string used for session token HMAC (generate with: openssl rand -hex 32)
APP_PASSWORD="your-secure-password-here"
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Encryption (required in production, optional in development)
# ENCRYPTION_KEY: 64-character hex string (32 bytes) for AES-256-GCM encryption of API secrets
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Exchange API Keys (Read-Only!) — stored in DB, not here
# These are legacy env vars; the app now stores keys via the Settings UI.
# BYBIT_API_KEY=""
# BYBIT_API_SECRET=""
# BINANCE_API_KEY=""
# BINANCE_API_SECRET=""
